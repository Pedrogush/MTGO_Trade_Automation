<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MtgoTradeAutomation.TradeWatch</RootNamespace>
    <!-- A long-lived watcher: workstation GC without background threads, and a hard
         ceiling so a leak fails fast instead of eating the machine's memory. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="268435456" />
  </ItemGroup>

  <ItemGroup>
    <!-- Latest release; published from videre-project/MTGOSDK head 903a481c (2026-10-18). -->
    <PackageReference Include="MTGOSDK" Version="1.8.0.20261018" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
